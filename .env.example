# Copy to .env and change the password: cp .env.example .env
POSTGRES_DB=smartcampus_db
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=change_me

# Grafana (only used with: docker compose --profile monitoring up)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me

# Jenkins (only used with: docker compose --profile cicd up)
JENKINS_ADMIN_PASSWORD=change_me
